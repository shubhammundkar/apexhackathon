# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Gemini API Configuration (Official Google Gen AI SDK)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional: GitHub Personal Access Token (for higher rate limits: 5000 req/hr vs 60 req/hr)
# Not required for public repo analysis, but recommended for development
GITHUB_TOKEN=

# Repository Ingestion Constraints
MAX_REPO_FILES=500
MAX_FILE_SIZE_BYTES=300000
MAX_TOTAL_REPO_BYTES=25000000
CHUNK_SIZE_LINES=120
CHUNK_OVERLAP_LINES=20
CHUNKING_MODE=syntax
MAX_CHUNK_CHARS=1500
SYMBOL_BOOST=3
PATH_BOOST=2
BM25_K1=1.2
BM25_B=0.75
CONTEXT_TOKEN_BUDGET=6000
MAX_EXTRA_BLOCKS=4

# Adaptive Q&A Retrieval
RETRIEVAL_POOL=40
EVIDENCE_TOKEN_BUDGET=6000
NARROW_MIN_HITS=2
NARROW_MAX_HITS=5
NARROW_CUTOFF=0.6
NORMAL_MIN_HITS=3
NORMAL_MAX_HITS=8
NORMAL_CUTOFF=0.5
BROAD_MIN_HITS=4
BROAD_MAX_HITS=12
BROAD_CUTOFF=0.35
MAX_CHUNKS_PER_FILE=3
MAX_CHUNKS_PER_FILE_BROAD=4

# Architecture Context Selection (Gemini analysis prompt)
ARCH_CONTEXT_MAX_FILES=25
ARCH_CONTEXT_CHAR_BUDGET=60000

# Parser Key Functions Limits
MAX_KEY_FUNCTIONS_PER_FILE=40
AI_MAX_FUNCTIONS_PER_FILE=20
