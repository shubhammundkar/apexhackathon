{
  "name": "codebase-explainer-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue.bold,magenta.bold\" \"pnpm --filter @codebase-explainer/backend dev\" \"pnpm --filter @codebase-explainer/frontend dev\"",
    "dev:backend": "pnpm --filter @codebase-explainer/backend dev",
    "dev:frontend": "pnpm --filter @codebase-explainer/frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @codebase-explainer/backend test",
    "test:frontend": "pnpm --filter @codebase-explainer/frontend test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.5.4"
  }
}
